# Panel de Aliados — variables de entorno
# Copiar como .env.local en desarrollo o configurar en Coolify

# URL del backend FastAPI (sin slash final)
NEXT_PUBLIC_API_BASE_URL=https://api.bigotesypaticas.com

# Google Maps JS API — misma key ya activa en apps/store
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# URL del panel en producción
NEXT_PUBLIC_ALIADOS_URL=https://aliados.bigotesypaticas.com
